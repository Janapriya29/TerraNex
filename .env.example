# ==============================================================================
# TerraNex Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env with production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
BACKEND_PORT=8002
FRONTEND_PORT=8080
MONGO_PORT=27018

# MongoDB Connection URL
# Production Option (Recommended for EC2 to save RAM & disk): MongoDB Atlas M0 Free Tier
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/TerraNex?retryWrites=true&w=majority
# Development Option A: Connect directly to existing host MongoDB (preserves local records):
# MONGODB_URL=mongodb://host.docker.internal:27017/TerraNex
# Development Option B: Connect to isolated container MongoDB:
# MONGODB_URL=mongodb://mongodb:27017/TerraNex
# Local development default: mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_TIMEOUT_MS=10000

# Production Prebuilt Images (for docker-compose.prod.yml)
FRONTEND_IMAGE=ghcr.io/janapriya29/terranex-frontend:latest
BACKEND_IMAGE=ghcr.io/janapriya29/terranex-backend:latest

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://localhost:80

# Paths (defaults to local repository root /models and /uploads if left empty)
# Inside Docker container: /app/models and /app/uploads
MODEL_DIR=
UPLOAD_DIR=

# Stage 1 Species Gatekeeper Feature Flag
ENABLE_STAGE1_SPECIES=true

# ------------------------------------------------------------------------------
# Frontend Service Configuration
# ------------------------------------------------------------------------------
# Base API URL for frontend client requests.
# - Local Vite development / Docker with Nginx reverse proxy: leave empty ("")
# - External/standalone backend deployment: specify full URL (e.g., https://api.terranex.com)
VITE_API_BASE_URL=

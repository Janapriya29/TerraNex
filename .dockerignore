# Version Control
.git/
.gitignore

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node dependencies
node_modules/
frontend/node_modules/
.npm/

# Intermediate frontend build artifacts
frontend/dist/
frontend/build/

# Raw training datasets (very large, not needed at runtime)
data/

# Notebooks and data science exploratory reports
notebooks/
reports/

# Runtime uploaded leaf images (mounted via volume)
uploads/disease_images/*
!uploads/disease_images/.gitkeep

# Local environment & secret files
.env
.env.*
!.env.example
backups/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
